# ToolGuard Environment Variables
# Note: Firebase Web SDK config keys are client-identifying configuration parameters, not admin secrets.
# Access control and enforcement must come from Firestore Security Rules, Cloud Functions, and App Check.
# NEVER commit private API keys, service accounts, or private credentials to this file or the repository.

# Web Dashboard (Firebase Web SDK)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=toolguard-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=toolguard-prod
VITE_FIREBASE_STORAGE_BUCKET=toolguard-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Firebase Emulators (for local development)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
