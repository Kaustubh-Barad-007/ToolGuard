rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
      );
    }

    // User profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Project documents
    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isProjectMember(projectId) &&
                    request.resource.data.ownerId == resource.data.ownerId; // Prevent transferring ownership
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isProjectMember(projectId);
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Tools subcollection
      match /tools/{toolId} {
        allow read: if isProjectMember(projectId);
        allow create, update: if isProjectMember(projectId);
        allow delete: if isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Baselines subcollection - immutable historical records
      match /baselines/{baselineId} {
        allow read: if isProjectMember(projectId);
        // Baselines can be created, but never edited or deleted by clients
        allow create: if isProjectMember(projectId) &&
                      request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Scans subcollection
      match /scans/{scanId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId);
        allow update, delete: if false;
      }

      // Drift events subcollection
      match /driftEvents/{eventId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId);
        // Updating drift status (e.g. accepted, reviewed) requires recording the actor
        allow update: if isProjectMember(projectId) &&
                      request.resource.data.acceptedBy == request.auth.uid;
        allow delete: if false;
      }

      // Audit logs - append-only, immutable history
      match /auditLogs/{auditId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) &&
                      request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
